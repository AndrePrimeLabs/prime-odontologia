u05e0\u05d5\u05ea \u05e9\u05dc\u05d9"],"Set up shipping rates":["\u05d4\u05d2\u05d3\u05e8\u05ea \u05ea\u05e2\u05e8\u05d9\u05e4\u05d9 \u05de\u05e9\u05dc\u05d5\u05d7"],"Set my product pricing":["\u05e7\u05d1\u05e2 \u05d0\u05ea \u05ea\u05de\u05d7\u05d5\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8 \u05e9\u05dc\u05d9"],"Help me to write a product description":["\u05ea\u05e2\u05d6\u05e8\u05d5 \u05dc\u05d9 \u05dc\u05db\u05ea\u05d5\u05d1 \u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05d5\u05e6\u05e8"],"Write a product description":["\u05dc\u05db\u05ea\u05d5\u05d1 \u05ea\u05d9\u05d0\u05d5\u05e8 \u05dc\u05de\u05d5\u05e6\u05e8"],"Help me to create a product":["\u05e2\u05d6\u05d5\u05e8 \u05dc\u05d9 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05de\u05d5\u05e6\u05e8"],"Add to post":["\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05dc\u05e4\u05d5\u05e1\u05d8"],"Replace selected image":["\u05d4\u05d7\u05dc\u05e4\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4"],"Start a new chat":["\u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05e6'\u05d0\u05d8 \u05d7\u05d3\u05e9"],"Start a new chat to begin":["\u05d4\u05ea\u05d7\u05dc \u05e6'\u05d0\u05d8 \u05d7\u05d3\u05e9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc"],"No past conversations":["\u05d0\u05d9\u05df \u05e9\u05d9\u05d7\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d5\u05ea"],"Failed to load conversations. Please try again.":["\u05d4\u05d8\u05e2\u05d9\u05e0\u05d4 \u05e9\u05dc \u05d4\u05e9\u05d9\u05d7\u05d5\u05ea \u05e0\u05db\u05e9\u05dc\u05d4. \u05d9\u05e9 \u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."],"Past chats":["\u05e6'\u05d0\u05d8\u05d9\u05dd \u05e7\u05d5\u05d3\u05de\u05d9\u05dd"],"Failed to upload images. Please try again.":["\u05d4\u05e2\u05dc\u05d0\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e0\u05db\u05e9\u05dc\u05d4. \u05d9\u05e9 \u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."],"Tell me what you can do for me":["\u05de\u05d4 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e2\u05e9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8\u05d9"],"Create a product":["\u05d9\u05e6\u05d9\u05e8\u05ea \u05de\u05d5\u05e6\u05e8"],"Show me recent comments":["\u05d4\u05e6\u05d2 \u05dc\u05d9 \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea"],"Review comments":["\u05dc\u05d1\u05d3\u05d5\u05e7 \u05ea\u05d2\u05d5\u05d1\u05d5\u05ea"],"Show me my site health status":["\u05d4\u05e8\u05d0\u05d4 \u05dc\u05d9 \u05d0\u05ea \u05de\u05e6\u05d1 \u05d4\u05d1\u05e8\u05d9\u05d0\u05d5\u05ea \u05e9\u05dc \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05d9"],"Check site health":["\u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05ea\u05e7\u05d9\u05e0\u05d5\u05ea \u05d4\u05d0\u05ea\u05e8"],"Help me create a new post":["\u05ea\u05e2\u05d6\u05e8\u05d5 \u05dc\u05d9 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e4\u05d5\u05e1\u05d8 \u05d7\u05d3\u05e9"],"Create content":["\u05dc\u05d9\u05e6\u05d5\u05e8 \u05ea\u05d5\u05db\u05df"],"Show me my recent posts":["\u05d4\u05e6\u05d9\u05d2\u05d5 \u05dc\u05d9 \u05d0\u05ea \u05d4\u05e4\u05d5\u05e1\u05d8\u05d9\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05d9"],"Manage posts":["\u05dc\u05e0\u05d4\u05dc \u05e4\u05d5\u05e1\u05d8\u05d9\u05dd"],"Unable to authenticate with Jetpack. Please try again.":["\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d0\u05de\u05ea \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea Jetpack. \u05db\u05d3\u05d0\u05d9 \u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."],"Network connection issue. Please check your internet connection and try again.":["\u05d1\u05e2\u05d9\u05d4 \u05d1\u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05e8\u05e9\u05ea. \u05d9\u05e9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05d5\u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."],"Unable to connect to Jetpack. Please ensure Jetpack is active and up to date.":["\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d7\u05d1\u05e8 \u05d0\u05dc Jetpack. \u05e0\u05d0 \u05dc\u05d5\u05d5\u05d3\u05d0 \u05db\u05d9 Jetpack \u05e4\u05e2\u05d9\u05dc \u05d5\u05de\u05e2\u05d5\u05d3\u05db\u05df."],"You don't have permission to access AI features.":["\u05d0\u05d9\u05df \u05dc\u05da \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d2\u05d9\u05e9\u05d4 \u05dc\u05db\u05dc\u05d9 \u05d1\u05d9\u05e0\u05d4 \u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea."],"Your session expired. Please refresh the page and try again.":["\u05e4\u05d2 \u05ea\u05d5\u05e7\u05e3 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc\u05da. \u05d9\u05e9 \u05dc\u05e8\u05e2\u05e0\u05df \u05d0\u05ea \u05d4\u05e2\u05de\u05d5\u05d3 \u05d5\u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."],"What else can you do?":["\u05de\u05d4 \u05e2\u05d5\u05d3 \u05d1\u05d9\u05db\u05d5\u05dc\u05ea\u05da \u05dc\u05e2\u05e9\u05d5\u05ea?"],"Got a different request? Ask away.":["\u05d9\u05e9 \u05dc\u05da \u05d1\u05e7\u05e9\u05d4 \u05d0\u05d7\u05e8\u05ea? \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05d0\u05d5\u05dc \u05d4\u05db\u05d5\u05dc."],"Howdy! How can I help you today?":["\u05d0\u05d4\u05dc\u05df! \u05d0\u05d9\u05da \u05d0\u05d5\u05db\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05d4\u05d9\u05d5\u05dd?"]}}}