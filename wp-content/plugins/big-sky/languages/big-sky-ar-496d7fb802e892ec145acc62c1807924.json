st chats":["\u0627\u0644\u062f\u0631\u062f\u0634\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629"],"Failed to upload images. Please try again.":["\u0641\u0634\u0644 \u0631\u0641\u0639 \u0627\u0644\u0635\u0648\u0631. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u062c\u062f\u062f\u064b\u0627."],"Tell me what you can do for me":["\u0623\u062e\u0628\u0631\u0646\u064a \u0645\u0627 \u064a\u0645\u0643\u0646\u0643 \u0641\u0639\u0644\u0647 \u0645\u0646 \u0623\u062c\u0644\u064a"],"Create a product":["\u0625\u0646\u0634\u0627\u0621 \u0645\u0646\u062a\u062c"],"Show me recent comments":["\u0639\u0631\u0636 \u0623\u062d\u062f\u062b \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a"],"Review comments":["\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a"],"Show me my site health status":["\u0639\u0631\u0636 \u062d\u0627\u0644\u0629 \u0633\u0644\u0627\u0645\u0629 \u0645\u0648\u0642\u0639\u064a"],"Check site health":["\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u062d\u0629 \u0627\u0644\u0645\u0648\u0642\u0639"],"Help me create a new post":["\u0645\u0633\u0627\u0639\u062f\u062a\u064a \u0639\u0644\u0649 \u0625\u0646\u0634\u0627\u0621 \u062a\u062f\u0648\u064a\u0646\u0629 \u062c\u062f\u064a\u062f\u0629"],"Create content":["\u0625\u0646\u0634\u0627\u0621 \u0645\u062d\u062a\u0648\u0649"],"Show me my recent posts":["\u0639\u0631\u0636 \u0623\u062d\u062f\u062b \u0627\u0644\u062a\u062f\u0648\u064a\u0646\u0627\u062a \u0644\u064a"],"Manage posts":["\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u062f\u0648\u064a\u0646\u0627\u062a"],"Unable to authenticate with Jetpack. Please try again.":["\u062a\u062a\u0639\u0630\u0631 \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062e\u0627\u062f\u0645 Jetpack. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Network connection issue. Please check your internet connection and try again.":["\u062a\u0648\u062c\u062f \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0634\u0628\u0643\u0629. \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0648\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"Unable to connect to Jetpack. Please ensure Jetpack is active and up to date.":["\u064a\u062a\u0639\u0630\u0631 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0640 Jetpack \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0623\u0643\u062f \u0645\u0646 \u0623\u0646 Jetpack \u0646\u0634\u0637 \u0648\u0645\u062d\u062f\u062b."],"You don't have permission to access AI features.":["\u0644\u064a\u0633 \u0644\u062f\u064a\u0643 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0644\u0627\u0632\u0645\u0629 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a."],"Your session expired. Please refresh the page and try again.":["\u0627\u0646\u062a\u0647\u062a \u062c\u0644\u0633\u062a\u0643. \u064a\u0631\u062c\u0649 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."],"What else can you do?":["\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u0645\u0643\u0646\u0643 \u0641\u0639\u0644\u0647 \u0623\u064a\u0636\u0627\u061f"],"Got a different request? Ask away.":["\u0647\u0644 \u0644\u062f\u064a\u0643 \u0637\u0644\u0628 \u0645\u062e\u062a\u0644\u0641\u061f \u062a\u0641\u0636\u0644 \u0628\u0627\u0644\u0633\u0624\u0627\u0644."],"Howdy! How can I help you today?":["\u0645\u0631\u062d\u0628\u064b\u0627! \u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u064