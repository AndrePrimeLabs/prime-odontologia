{"translation-revision-date":"2026-09-03 02:55:50+0000","generator":"WP-CLI\/2.12.0","source":"build\/wp-orchestrator\/wp-admin\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"el_GR","plural-forms":"nplurals=2; plural=n != 1;"},"Personalize my site copy with my details.":["\u03a0\u03c1\u03bf\u03c3\u03b1\u03c1\u03bc\u03cc\u03c3\u03c4\u03b5 \u03c4\u03bf \u03b1\u03bd\u03c4\u03af\u03b3\u03c1\u03b1\u03c6\u03bf \u03c4\u03bf\u03c5 \u03b9\u03c3\u03c4\u03cc\u03c4\u03bf\u03c0\u03bf\u03cd \u03bc\u03bf\u03c5 \u03bc\u03b5 \u03c4\u03b9\u03c2 \u03bb\u03b5\u03c0\u03c4\u03bf\u03bc\u03ad\u03c1\u03b5\u03b9\u03ad\u03c2 \u03bc\u03bf\u03c5."],"New chat":["\u039d\u03ad\u03b1 \u03c3\u03c5\u03bd\u03bf\u03bc\u03b9\u03bb\u03af\u03b1"],"How can you help me?":["\u03a0\u03ce\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af\u03c2 \u03bd\u03b1 \u03bc\u03b5 \u03b2\u03bf\u03b7\u03b8\u03ae\u03c3\u03b5\u03b9\u03c2;"],"What should I do next?":["\u03a4\u03b9 \u03c0\u03c1\u03ad\u03c0\u03b5\u03b9 \u03bd\u03b1 \u03ba\u03ac\u03bd\u03c9 \u03c3\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ad\u03c7\u03b5\u03b9\u03b1;"],"Welcome to your new store! I'm your personal AI assistant. How can I help you?":["\u039a\u03b1\u03bb\u03ce\u03c2 \u03ae\u03c1\u03b8\u03b5\u03c2 \u03c3\u03c4\u03bf \u03bd\u03ad\u03bf \u03c3\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03b1! \u0395\u03af\u03bc\u03b1\u03b9 \u03bf \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03cc\u03c2 \u03c3\u03bf\u03c5 AI \u03b2\u03bf\u03b7\u03b8\u03cc\u03c2. \u03a0\u03ce\u03c2 \u03bc\u03c0\u03bf\u03c1\u03ce \u03bd\u03b1 \u03c3\u03b5 \u03b2\u03bf\u03b7\u03b8\u03ae\u03c3\u03c9;"],"Help me to connect PayPal Payments to my store":["\u0392\u03bf\u03ae\u03b8\u03b7\u03c3\u03ad \u03bc\u03b5 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b4\u03ad\u03c3\u03c9 \u03c4\u03b9\u03c2 \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ad\u03c2 PayPal \u03bc\u03b5 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03ac \u03bc\u03bf\u03c5"],"Connect PayPal Payments to my store":["\u03a3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7 \u03c0\u03bb\u03b7\u03c1\u03c9\u03bc\u03ce\u03bd PayPal \u03bc\u03b5 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03ac \u03bc\u03bf\u03c5"],"Recommend shipping zones and methods for my store":["\u03a3\u03c5\u03bd\u03b9\u03c3\u03c4\u03ae\u03c3\u03c4\u03b5 \u03b6\u03ce\u03bd\u03b5\u03c2 \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae\u03c2 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03b8\u03cc\u03b4\u03bf\u03c5\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b7\u03bc\u03ac \u03bc\u03bf\u03c5"],"Set up shipping rates":["\u03a1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b7 \u03c4\u03b9\u03bc\u03ce\u03bd \u03b1\u03c0\u03bf\u03c3\u03c4\u03bf\u03bb\u03ae\u03c2"],"Set my product pricing":["\u03a1\u03cd\u03b8\u03bc\u03b9\u03c3\u03b5 \u03c4\u03b9\u03c2 \u03c4\u03b9\u03bc\u03ad\u03c2 \u03c4\u03bf\u03c5 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2 \u03bc\u03bf\u03c5"],"Help me to write a product description":["\u0392\u03bf\u03ae\u03b8\u03b7\u03c3\u03ad \u03bc\u03b5 \u03bd\u03b1 \u03b3\u03c1\u03ac\u03c8\u03c9 \u03bc\u03b9\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2"],"Write a product description":["\u0393\u03c1\u03ac\u03c8\u03b5 \u03bc\u03b9\u03b1 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd\u03c4\u03bf\u03c2"],"Help me to create a product":["\u0392\u03bf\u03ae\u03b8\u03b7\u03c3\u03ad \u03bc\u03b5 \u03bd\u03b1 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03c3\u03c9 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03bf\u03ca\u03cc\u03bd"],"Add to post":["\u03a0\u03c1\u03bf\u03c3\u03b8\u03ae\u03ba\u03b7 \u03c3\u03c4\u03bf \u03ac\u03c1\u03b8\u03c1\u03bf"],"Replace selected image":["\u0391\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c3\u03b7 \u03b5\u03c0\u03b9\u03bb\u03b5\u03b3\u03bc\u03ad\u03bd\u03b7\u03c2 \u03b5\u03b9\u03ba\u03cc\u03bd