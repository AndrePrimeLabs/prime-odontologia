f\u03c2"],"Refresh":["\u0391\u03bd\u03b1\u03bd\u03ad\u03c9\u03c3\u03b7"],"%s \u2013 draft":["%s \u2013 \u03c0\u03c1\u03bf\u03c3\u03c7\u03ad\u03b4\u03b9\u03bf"],"Loading pages\u2026":["\u03a6\u03cc\u03c1\u03c4\u03c9\u03c3\u03b7 \u03c3\u03b5\u03bb\u03af\u03b4\u03c9\u03bd\u2026"],"Site pages":["\u03a3\u03b5\u03bb\u03af\u03b4\u03b5\u03c2 \u0399\u03c3\u03c4\u03cc\u03c4\u03bf\u03c0\u03bf\u03c5"],"Draft":["\u03a0\u03c1\u03bf\u03c3\u03c7\u03ad\u03b4\u03b9\u03bf"],"Preview size":["\u039c\u03ad\u03b3\u03b5\u03b8\u03bf\u03c2 \u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7\u03c2"],"Device Preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03a3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ae\u03c2"],"Mobile preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03ba\u03b9\u03bd\u03b7\u03c4\u03bf\u03cd"],"Mobile":["\u039a\u03b9\u03bd\u03b7\u03c4\u03cc"],"Tablet preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u039a\u03b1\u03c1\u03c4\u03ad\u03bb\u03b1\u03c2"],"Tablet":["\u03a4\u03b1\u03bc\u03c0\u03bb\u03ad\u03c4\u03b1"],"Desktop preview":["\u03a0\u03c1\u03bf\u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03b5\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1\u03c2 \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2"],"Desktop":["\u0395\u03c0\u03b9\u03c6\u03ac\u03bd\u03b5\u03b9\u03b1 \u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1\u03c2"],"Layout %d":["\u0394\u03b9\u03ac\u03c4\u03b1\u03be\u03b7 %d"],"Next":["\u0395\u03c0\u03cc\u03bc\u03b5\u03bd\u03bf"],"%1$d\/%2$d":["%1$d\/%2$d"],"Previous":["\u03a0\u03c1\u03bf\u03b7\u03b3\u03bf\u03cd\u03bc\u03b5\u03bd\u03bf"],"Select %s":["\u0395\u03c0\u03b9\u03bb\u03ad\u03be\u03c4\u03b5 %s"],"The selection could not be staged. Please try again.":["\u0397 \u03b5\u03c0\u03b9\u03bb\u03bf\u03b3\u03ae \u03b4\u03b5\u03bd \u03bc\u03c0\u03cc\u03c1\u03b5\u03c3\u03b5 \u03bd\u03b1 \u03c3\u03c4\u03b7\u03b8\u03b5\u03a