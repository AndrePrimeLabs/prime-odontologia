{"translation-revision-date":"2026-05-25 10:55:42+0000","generator":"WP-CLI\/2.12.0","source":"dist\/assets\/easy-site-editor.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ko_KR","plural-forms":"nplurals=1; plural=0;"},"Tracks Dashboard":["\ud2b8\ub799\uc2a4 \uc54c\ub9bc\ud310"],"Errors Dashboard":["\uc624\ub958 \uc54c\ub9bc\ud310"],"Tell us more":["\ub354 \ub9d0\ud574 \uc918"],"Bad response":["\ud488\uc9c8\uc774 \ub0ae\uc740 \uc751\ub2f5"],"Good response":["\ud488\uc9c8\uc774 \ub192\uc740 \uc751\ub2f5"],"Feedback could not be sent. Please try again.":["\ud53c\ub4dc\ubc31\uc744 \ubcf4\ub0bc \uc218 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."],"Send feedback":["\ud53c\ub4dc\ubc31 \ubcf4\ub0b4\uae30"],"Sending\u2026":["\uc804\uc1a1 \uc911\u2026"],"Cancel":["\ucde8\uc18c"],"What did you expect instead?":["\ub300\uc2e0 \ubb50\ub97c \uae30\ub300\ud588\uc5b4?"],"Add any details that would help us improve this response.":["\uc774 \uc751\ub2f5\uc744 \uac1c\uc120\ud558\ub294 \ub370 \ub3c4\uc6c0\uc774 \ub420 \uc218 \uc788\ub294 \uc138\ubd80 \uc815\ubcf4\ub97c \ucd94\uac00\ud574 \uc8fc\uc138\uc694."],"What went wrong?":["\ubb50\uac00 \uc798\ubabb\ub410\uc5b4?"],"The current preview is not editable. It may be a dynamic front page. Tell the user to open a different page and try again.":["\ud604\uc7ac \ubbf8\ub9ac\ubcf4\uae30\ub294 \uc218\uc815\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub3d9\uc801 \ud504\ub860\ud2b8 \ud398\uc774\uc9c0\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub2e4\ub978 \ud398\uc774\uc9c0\ub97c \uc5f4\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\ub77c\uace0 \uc54c\ub824\uc8fc\uc138\uc694."],"WordPress Admin":["\uc6cc\ub4dc\ud504\ub808\uc2a4 \uad00\ub9ac\uc790"],"Dismiss announcement":["\uacf5\uc9c0\uc0ac\ud56d \ub2eb\uae30"],"Switch to the full Site Editor instead.":["\ub300\uc2e0 \uc804\uccb4 \uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30\ub85c \uc804\ud658\ud558\uc138\uc694."],"You're using the new experimental Easy Site Editor.":["\ub108\ub294 \uc0c8\ub85c\uc6b4 \uc2e4\ud5d8\uc801\uc778 \uc26c\uc6b4 \uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30\ub97c \uc0ac\uc6a9\ud558\uace0 \uc788\uc5b4."],"Publish":["\ubc1c\ud589"],"Launch your site":["\uc0ac\uc774\ud2b8 \uc2dc\uc791"],"Redo":["\ub2e4\uc2dc\ud558\uae30"],"Undo":["\ub418\ub3cc\ub9ac\uae30"],"%1$s (%2$s)":["%1$s (%2$s)"],"Discard":["\ucde8\uc18c"],"No active session yet.":["\uc544\uc9c1 \ud65c\uc131 \uc138\uc158\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."],"Langfuse trace":["Langfuse \ucd94\uc801"],"Debug":["\ub514\ubc84\uadf8"],"You have unsaved changes. If you leave before saving, your changes will be lost.":["\uc800\uc7a5\ub418\uc9c0 \uc54a\uc740 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ud558\uae30 \uc804\uc5d0 \ub098\uac00\uba74 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc0ac\ub77c\uc9d1\ub2c8\ub2e4."],"The editor is still loading. Try the request again once the page is editable.":["\ud3b8\uc9d1\uae30\uac00 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \ud398\uc774\uc9c0\uac00 \ud3b8\uc9d1 \uac00\ub2a5\ud574\uc9c0\uba74 \uc694\uccad\uc744 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"The requested theme update has been staged in the editor.":["\uc694\uccad\ub41c \ud14c\ub9c8 \uc5c5\ub370\uc774\ud2b8\uac00 \ud3b8\uc9d1\uae30\uc5d0 \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Global styles are still loading. Try the theme update again in a moment.":["\uc804\uccb4 \uc2a4\ud0c0\uc77c\uc774 \uc544\uc9c1 \ub85c\ub529 \uc911\uc785\ub2c8\ub2e4. \uc7a0\uc2dc \ud6c4 \ud14c\ub9c8 \uc5c5\ub370\uc774\ud2b8\ub97c \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Invalid arguments. Provide either settings or styles to update the theme.":["\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \uc778\uc218. \uc124\uc815 \ub610\ub294 \uc2a4\ud0c0\uc77c\uc744 \uc81c\uacf5\ud558\uace0 \ud14c\ub9c8\ub97c \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694."],"Invalid styles format. Styles must be an object.":["\uc2a4\ud0c0\uc77c \ud615\uc2dd\uc774 \uc720\ud6a8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc2a4\ud0c0\uc77c\uc740 \uac1d\uccb4\uc5ec\uc57c \ud569\ub2c8\ub2e4."],"Invalid settings format. Settings must be an object.":["\uc124\uc815 \ud615\uc2dd\uc774 \uc720\ud6a8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc124\uc815\uc740 \uac1d\uccb4\uc5ec\uc57c \ud569\ub2c8\ub2e4."],"Create a new page on my site":["\ub0b4 \uc0ac\uc774\ud2b8\uc5d0 \uc0c8 \ud398\uc774\uc9c0 \ub9cc\ub4e4\uae30"],"Add new page":["\uc0c8 \ud398\uc774\uc9c0 \ucd94\uac00"],"Suggest a new font family for my site that is:":["\ub0b4 \uc0ac\uc774\ud2b8\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uae00\uaf34 \ud328\ubc00\ub9ac\ub97c \uc81c\uc548\ud574\uc918:"],"Choose new fonts":["\uc0c8 \uae00\uaf34 \uc120\ud0dd"],"Suggest a different layout for this page":["\uc774 \ud398\uc774\uc9c0\uc5d0 \ub300\ud55c \ub2e4\ub978 \ub808\uc774\uc544\uc6c3\uc744 \uc81c\uc548\ud574 \uc8fc\uc138\uc694"],"Change page layout":["\ud398\uc774\uc9c0 \ub808\uc774\uc544\uc6c3 \ubcc0\uacbd"],"Suggest a new color palette for my site that is:":["\ub0b4 \uc0ac\uc774\ud2b8\uc5d0 \ub300\ud55c \uc0c8\ub85c\uc6b4 \uc0c9\uc0c1 \ud314\ub808\ud2b8\ub97c \uc81c\uc548\ud574\uc918: "],"Customize colors":["\uc0c9\uc0c1 \uc0ac\uc6a9\uc790 \uc815\uc758"],"Home":["\ud648"],"Unable to load pages.":["\ud398\uc774\uc9c0\ub97c \ubd88\ub7ec\uc62c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Global styles are still loading. Try the selection again in a moment.":["\uc804\uccb4 \uc2a4\ud0c0\uc77c\uc774 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \uc7a0\uc2dc \ud6c4\uc5d0 \uc120\ud0dd\uc744 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Successfully navigated to: %s":["\uc131\uacf5\uc801\uc73c\ub85c \uc774\ub3d9\ud588\uc2b5\ub2c8\ub2e4: %s"],"The current page has unsaved changes, so navigation to %s was canceled. If this was requested after creating a page, the page has already been created. Tell the user to save or discard their current changes, then open the page from the page picker.":["\ud604\uc7ac \ud398\uc774\uc9c0\uc5d0 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc740 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc788\uc5b4 %s\ub85c\uc758 \ud0d0\uc0c9\uc774 \ucde8\uc18c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ud398\uc774\uc9c0\ub97c \uc0dd\uc131\ud55c \ud6c4\uc5d0 \uc774 \uc694\uccad\uc774 \uc788\uc5c8\ub2e4\uba74, \ud398\uc774\uc9c0\ub294 \uc774\ubbf8 \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud604\uc7ac \ubcc0\uacbd \uc0ac\ud56d\uc744 \uc800\uc7a5\ud558\uac70\ub098 \ud3d0\uae30\ud558\ub77c\uace0 \ub9d0\ud55c \ub2e4\uc74c, \ud398\uc774\uc9c0 \uc120\ud0dd\uae30\uc5d0\uc11c \ud398\uc774\uc9c0\ub97c \uc5f4\uc5b4\ubcf4\ub77c\uace0 \ud558\uc138\uc694."],"Invalid path provided. Path must be a non-empty string.":["\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \uacbd\ub85c\uac00 \uc81c\uacf5\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uacbd\ub85c\ub294 \ube44\uc5b4 \uc788\uc9c0 \uc54a\uc740 \ubb38\uc790\uc5f4\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4."],"Jetpack token context is unavailable.":["\uc82f\ud329 \ud1a0\ud070 \ucee8\ud14d\uc2a4\ud2b8\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Failed to display picker.":["\ud53d\ucee4\ub97c \ud45c\uc2dc\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."],"Picker displayed successfully.":["\ud53d\ucee4\uac00 \uc131\uacf5\uc801\uc73c\ub85c \ud45c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Unsupported component type: %s":["\uc9c0\uc6d0\ub418\uc9c0 \uc54a\ub294 \uad6c\uc131 \uc694\uc18c \uc720\ud615: %s"],"Clear selected block":["\uc120\ud0dd\ud55c \ube14\ub85d \uc9c0\uc6b0\uae30"],"Selected block: %s":["\uc120\ud0dd\ud55c \ube14\ub85d: %s"],"Site frontend preview":["\uc0ac\uc774\ud2b8 \ud504\ub860\ud2b8\uc5d4\ub4dc \ubbf8\ub9ac\ubcf4\uae30"],"Preview loaded":["\ubbf8\ub9ac \ubcf4\uae30 \ub85c\ub4dc\ub428"],"Loading preview\u2026":["\ubbf8\ub9ac \ubcf4\ub2e4 \ub85c\ub529 \uc911\u2026"],"Site preview panel":["\uc0ac\uc774\ud2b8 \ubbf8\ub9ac\ubcf4\uae30 \ud328\ub110"],"Site editor panel":["\uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30 \ud328\ub110"],"Preview Site":["\ubbf8\ub9ac\ubcf4\uae30 \uc0ac\uc774\ud2b8"],"Refresh":["\uc0c8\ub85c \uace0\uce68"],"%s \u2013 draft":["%s \u2013 \uc784\uc2dc\uae00"],"Loading pages\u2026":["\ud398\uc774\uc9c0 \ub85c\ub529 \uc911\u2026"],"Site pages":["\uc0ac\uc774\ud2b8 \ud398\uc774\uc9c0"],"Draft":["\uc784\uc2dc\uae00"],"Preview size":["\ubbf8\ub9ac\ubcf4\uae30 \ud06c\uae30"],"Device Preview":["\uae30\uae30 \ubbf8\ub9ac\ubcf4\uae30"],"Mobile preview":["\ubaa8\ubc14\uc77c \ubbf8\ub9ac\ubcf4\uae30"],"Mobile":["\ubaa8\ubc14\uc77c"],"Tablet preview":["\ud0dc\ube14\ub9bf \ubbf8\ub9ac\ubcf4\uae30"],"Tablet":["\ud0dc\ube14\ub9bf"],"Desktop preview":["\ub370\uc2a4\ud06c\ud0d1 \ubbf8\ub9ac\ubcf4\uae30"],"Desktop":["\ub370\uc2a4\ud06c\ud1b1"],"Layout %d":["\ub808\uc774\uc544\uc6c3 %d"],"Next":["\ub2e4\uc74c"],"%1$d\/%2$d":["%1$d\/%2$d"],"Previous":["\uc774\uc804"],"Select %s":["%s \uc120\ud0dd"],"The selection could not be staged. Please try again.":["\uc120\ud0dd\uc744 \uc9c4\ud589\ud560 \uc218 \uc5c6\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."],"The editor is still loading. Try again in a moment.":["\ud3b8\uc9d1\uae30\uac00 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \uc7a0\uc2dc \ud6c4\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"There was a problem retrieving options. Please try again.":["\uc635\uc158 \uc870\ud68c \uc911 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694."],"Resize chat panel":["\ucc44\ud305 \ud328\ub110 \ud06c\uae30 \uc870\uc815"],"Insertions must include block data with a block name.":["\uc0bd\uc785\ubb3c\uc5d0\ub294 \ube14\ub85d \uc774\ub984\uc774 \ud3ec\ud568\ub41c \ube14\ub85d \ub370\uc774\ud130\uac00 \uc788\uc5b4\uc57c \ud574."],"Updates must include the clientId of the block to update.":["\uc5c5\ub370\uc774\ud2b8\uc5d0\ub294 \uc5c5\ub370\uc774\ud2b8\ud560 \ube14\ub85d\uc758 clientId\uac00 \ud3ec\ud568\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4."],"Block type \"%s\" is not available.":["\ube14\ub85d \uc720\ud615 \"%s\"\uc744(\ub97c) \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Block data must include a block name.":["\ube14\ub85d \ub370\uc774\ud130\uc5d0\ub294 \ube14\ub85d \uc774\ub984\uc774 \ud3ec\ud568\ub418\uc5b4\uc57c \ud569\ub2c8\ub2e4."],"Global styles are still loading. Try the block edit again in a moment.":["\uc804\uccb4 \uc2a4\ud0c0\uc77c\uc774 \uc544\uc9c1 \ub85c\ub529 \uc911\uc785\ub2c8\ub2e4. \uc7a0\uc2dc \ud6c4\uc5d0 \ube14\ub85d \ud3b8\uc9d1\uc744 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Apply block edits needs at least one update, insert, delete, or summary.":["\ube14\ub85d \ud3b8\uc9d1\uc744 \uc801\uc6a9\ud558\ub824\uba74 \ucd5c\uc18c\ud55c \ud558\ub098\uc758 \uc5c5\ub370\uc774\ud2b8, \uc0bd\uc785, \uc0ad\uc81c \ub610\ub294 \uc694\uc57d\uc774 \ud544\uc694\ud574."],"The requested block edits have been staged in the editor.":["\uc694\uccad\ub41c \ube14\ub85d \ud3b8\uc9d1\uc774 \ud3b8\uc9d1\uae30\uc5d0 \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Block \"%s\" was not found for deletion.":["\ube14\ub85d \"%s\"\ub97c \uc0ad\uc81c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Could not map client ID \"%s\" for deletion.":["\uc0ad\uc81c\ub97c \uc704\ud574 \ud074\ub77c\uc774\uc5b8\ud2b8 ID \"%s\"\ub97c \ub9e4\ud551\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Block \"%s\" was not found for update.":["\ube14\ub85d \"%s\"\ub97c \uc5c5\ub370\uc774\ud2b8\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Could not map client ID \"%s\" for update.":["\uc5c5\ub370\uc774\ud2b8\ub97c \uc704\ud574 \ud074\ub77c\uc774\uc5b8\ud2b8 ID \"%s\"\ub97c \ub9e4\ud551\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Parent block \"%s\" was not found for insertion.":["\uc0bd\uc785\uc744 \uc704\ud55c \ubd80\ubaa8 \ube14\ub85d \"%s\"\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Could not map parent client ID \"%s\" for insertion.":["\uc0bd\uc785\uc744 \uc704\ud574 \ubd80\ubaa8 \ud074\ub77c\uc774\uc5b8\ud2b8 ID \"%s\"\ub97c \ub9e4\ud551\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Loading editor\u2026":["\ud3b8\uc9d1\uae30 \ub85c\ub529 \uc911\u2026"],"Failed to load template.":["\ud15c\ud50c\ub9bf\uc744 \ub85c\ub4dc\ud558\ub294 \ub370 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4."],"Ask for changes":["\ubcc0\uacbd \uc694\uccad\ud558\uae30"],"Cannot create a block without a name.":["\uc774\ub984 \uc5c6\uc774 \ube14\ub85d\uc744 \uc0dd\uc131\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"The selected pattern layout has been staged in the editor.":["\uc120\ud0dd\ud55c \ud328\ud134 \ub808\uc774\uc544\uc6c3\uc774 \ud3b8\uc9d1\uae30\uc5d0 \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4."],"Cannot stage a pattern layout without blocks.":["\ube14\ub85d \uc5c6\uc774 \ud328\ud134 \ub808\uc774\uc544\uc6c3\uc744 \ubc30\uce58\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."],"Start a new conversation":["\uc0c8 \ub300\ud654 \uc2dc\uc791\ud558\uae30"],"Publishing\u2026":["\uacf5\uac1c\uc911..."],"Saving\u2026":["\uc800\uc7a5 \uc911..."],"Save":["\uc800\uc7a5"],"Save draft":["\uc784\uc2dc\uae00 \uc800\uc7a5"],"Keep editing":["\uacc4\uc18d \ud3b8\uc9d1\ud558\uae30"],"Unsaved changes":["\uc800\uc7a5\ub418\uc9c0 \uc54a\uc740 \ubcc0\uacbd\uc0ac\ud56d"],"Edit":["\ud3b8\uc9d1"],"Edit mode":["\ud3b8\uc9d1 \ubaa8\ub4dc"],"Preview":["\ubbf8\ub9ac\ubcf4\uae30"],"Preview mode":["\ubbf8\ub9ac\ubcf4\uae30 \ubaa8\ub4dc"],"Editor mode":["\ud3b8\uc9d1\uae30 \ubaa8\ub4dc"],"Use this for site-wide theme.json settings or styles. After it succeeds, tell the user the theme update is staged in the editor and ready to review\/save, not live or published.":["\uc0ac\uc774\ud2b8 \uc804\uccb4\uc758 theme.json \uc124\uc815\uc774\ub098 \uc2a4\ud0c0\uc77c\uc5d0 \uc774\uac78 \uc0ac\uc6a9\ud574. \uc131\uacf5\ud558\uba74 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud14c\ub9c8 \uc5c5\ub370\uc774\ud2b8\uac00 \ud3b8\uc9d1\uae30\uc5d0 \uc900\ube44\ub418\uc5b4 \uc788\uace0 \uac80\ud1a0\/\uc800\uc7a5\ud560 \uc218 \uc788\uc9c0\ub9cc, \ub77c\uc774\ube0c\ub098 \ubc1c\ud589\ub41c \uac74 \uc544\ub2c8\ub77c\uace0 \uc54c\ub824\uc918."],"Stages WordPress theme settings and styles using theme.json format.":["\ud14c\ub9c8.json \ud615\uc2dd\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc6cc\ub4dc\ud504\ub808\uc2a4 \ud14c\ub9c8 \uc124\uc815 \ubc0f \uc2a4\ud0c0\uc77c\uc744 \ub2e8\uacc4\ubcc4\ub85c \uc9c4\ud589\ud569\ub2c8\ub2e4."],"Update theme":["\ud14c\ub9c8 \uc5c5\ub370\uc774\ud2b8"],"The editor is still loading. Try the theme update again once the page is editable.":["\ud3b8\uc9d1\uae30\uac00 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \ud398\uc774\uc9c0\uac00 \ud3b8\uc9d1 \uac00\ub2a5\ud574\uc9c0\uba74 \ud14c\ub9c8 \uc5c5\ub370\uc774\ud2b8\ub97c \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Displays a font, color, or pattern picker in the Easy Site Editor chat.":["Easy Site Editor \ucc44\ud305\uc5d0\uc11c \uae00\uaf34, \uc0c9\uc0c1 \ub610\ub294 \ud328\ud134 \uc120\ud0dd\uae30\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4."],"Show picker":["\uc1fc \ud53d\ucee4"],"The picker UI is still loading. Try the request again in a moment.":["\ud53d\ucee4 UI\uac00 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \uc7a0\uc2dc \ud6c4\uc5d0 \uc694\uccad\uc744 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Use this to show staged global font, color, or pattern choices. The user must select an option and save before changes are live.":["\uc774\uac78 \uc0ac\uc6a9\ud574\uc11c \ub2e8\uacc4\ubcc4 \uae00\ub85c\ubc8c \uae00\uaf34, \uc0c9\uc0c1 \ub610\ub294 \ud328\ud134 \uc120\ud0dd\uc744 \ubcf4\uc5ec\uc918. \uc0ac\uc6a9\uc790\ub294 \uc635\uc158\uc744 \uc120\ud0dd\ud558\uace0 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc801\uc6a9\ub418\uae30 \uc804\uc5d0 \uc800\uc7a5\ud574\uc57c \ud574."],"Use this when the user asks to navigate, go to, open, view, or switch to a site page. If you call this after creating a new page, page creation is already complete before this tool runs. If navigation is canceled because the current page has unsaved changes, do not continue or retry page creation; tell the user the page exists and they need to save or discard their current changes before opening it.":["\uc0ac\uc6a9\uc790\uac00 \ud0d0\uc0c9, \uc774\ub3d9, \uc5f4\uae30, \ubcf4\ub2e4 \ub610\ub294 \uc0ac\uc774\ud2b8 \ud398\uc774\uc9c0\ub85c \uc804\ud658\ud558\ub77c\uace0 \uc694\uccad\ud560 \ub54c \uc774\uac78 \uc0ac\uc6a9\ud574. \uc0c8 \ud398\uc774\uc9c0\ub97c \ub9cc\ub4e0 \ud6c4\uc5d0 \uc774\uac78 \ud638\ucd9c\ud558\uba74, \uc774 \ub3c4\uad6c\uac00 \uc2e4\ud589\ub418\uae30 \uc804\uc5d0 \ud398\uc774\uc9c0 \uc0dd\uc131\uc774 \uc774\ubbf8 \uc644\ub8cc\ub3fc. \ud604\uc7ac \ud398\uc774\uc9c0\uc5d0 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc740 \ubcc0\uacbd \uc0ac\ud56d\uc774 \uc788\uc5b4\uc11c \ud0d0\uc0c9\uc774 \ucde8\uc18c\ub418\uba74, \ud398\uc774\uc9c0 \uc0dd\uc131\uc744 \uacc4\uc18d\ud558\uac70\ub098 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc9c0 \ub9c8; \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud398\uc774\uc9c0\uac00 \uc874\uc7ac\ud55c\ub2e4\uace0 \ub9d0\ud558\uace0, \uc5f4\uae30 \uc804\uc5d0 \ud604\uc7ac \ubcc0\uacbd \uc0ac\ud56d\uc744 \uc800\uc7a5\ud558\uac70\ub098 \ubc84\ub824\uc57c \ud55c\ub2e4\uace0 \uc54c\ub824\uc918."],"Navigates the Easy Site Editor preview to a specific site page or to the pages list.":["\uc26c\uc6b4 \uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30 \ubbf8\ub9ac\ubcf4\uae30\uc5d0\uc11c \ud2b9\uc815 \uc0ac\uc774\ud2b8 \ud398\uc774\uc9c0\ub098 \ud398\uc774\uc9c0 \ubaa9\ub85d\uc73c\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4."],"Navigate":["\ud0d0\uc0c9"],"Editor navigation is still loading. Try navigating again in a moment.":["\ud3b8\uc9d1\uae30 \ud0d0\uc0c9\uc774 \uc544\uc9c1 \ub85c\ub529 \uc911\uc785\ub2c8\ub2e4. \uc7a0\uc2dc \ud6c4\uc5d0 \ub2e4\uc2dc \ud0d0\uc0c9\ud574 \ubcf4\uc138\uc694."],"Stages block updates, insertions, and deletions in the client-side editor for review before saving.":["\uc800\uc7a5\ud558\uae30 \uc804\uc5d0 \ud074\ub77c\uc774\uc5b8\ud2b8 \uce21 \ud3b8\uc9d1\uae30\uc5d0\uc11c \ube14\ub85d \uc5c5\ub370\uc774\ud2b8, \uc0bd\uc785 \ubc0f \uc0ad\uc81c\ub97c \uac80\ud1a0\ud569\ub2c8\ub2e4."],"Apply block edits":["\ube14\ub85d \ud3b8\uc9d1 \uc801\uc6a9"],"Abilities for staging edits in the Easy Site Editor.":["\uc26c\uc6b4 \uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30\uc5d0\uc11c \ud3b8\uc9d1\uc744 \uc900\ube44\ud558\ub294 \ub2a5\ub825."],"Easy Site Editor":["\uc26c\uc6b4 \uc0ac\uc774\ud2b8 \ud3b8\uc9d1\uae30"],"The editor is still loading. Try the block edit again once the page is editable.":["\ud3b8\uc9d1\uae30\uac00 \uc544\uc9c1 \ub85c\ub529 \uc911\uc774\uc5d0\uc694. \ud398\uc774\uc9c0\uac00 \ud3b8\uc9d1 \uac00\ub2a5\ud574\uc9c0\uba74 \ube14\ub85d \ud3b8\uc9d1\uc744 \ub2e4\uc2dc \uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694."],"Use this for current-page content and layout edits. After it succeeds, tell the user the edits are staged in the editor and ready to review\/save, not live or published.":["\ud604\uc7ac \ud398\uc774\uc9c0\uc758 \ucf58\ud150\uce20 \ubc0f \ub808\uc774\uc544\uc6c3 \ud3b8\uc9d1\uc5d0 \uc0ac\uc6a9\ud558\uc138\uc694. \uc131\uacf5\ud55c \ud6c4, \uc0ac\uc6a9\uc790\uc5d0\uac8c \ud3b8\uc9d1\uc774 \ud3b8\uc9d1\uae30\uc5d0 \uc900\ube44\ub418\uc5b4 \uac80\ud1a0\/\uc800\uc7a5\ud560 \uc218 \uc788\ub3c4\ub85d \ub300\uae30 \uc911\uc774\uba70, \ub77c\uc774\ube0c \ub610\ub294 \ubc1c\ud589\ub418\uc9c0 \uc54a\uc558\ub2e4\uace0 \uc54c\ub824\uc8fc\uc138\uc694."]}}}