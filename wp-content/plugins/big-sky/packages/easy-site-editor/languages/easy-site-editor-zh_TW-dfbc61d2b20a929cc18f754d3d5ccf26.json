u6709\u540d\u7a31\u7684\u5340\u584a\u3002"],"The selected pattern layout has been staged in the editor.":["\u5df2\u5728\u7de8\u8f2f\u5668\u4e2d\u8a2d\u7f6e\u6240\u9078\u7684\u7248\u9762\u914d\u7f6e\u3002"],"Cannot stage a pattern layout without blocks.":["\u7121\u6cd5\u5728\u6c92\u6709\u5340\u584a\u7684\u60c5\u6cc1\u4e0b\u4f48\u7f6e\u7248\u9762\u914d\u7f6e\u3002"],"Start a new conversation":["\u958b\u59cb\u4e00\u500b\u65b0\u5c0d\u8a71"],"Publishing\u2026":["\u6b63\u5728\u767c\u4f48..."],"Saving\u2026":["\u5132\u5b58\u4e2d\u2026"],"Save":["\u5132\u5b58"],"Save draft":["\u5132\u5b58\u8349\u7a3f"],"Keep editing":["\u7e7c\u7e8c\u7de8\u8f2f"],"Unsaved changes":["\u5c1a\u672a\u5132\u5b58\u7684\u8a2d\u5b9a"],"Edit":["\u7de8\u8f2f"],"Edit mode":["\u7de8\u8f2f\u6a21\u5f0f"],"Preview":["\u9810\u89bd"],"Preview mode":["\u9810\u89bd\u6a21\u5f0f"],"Editor mode":["\u7de8\u8f2f\u5668\u6a21\u5f0f"],"Use this for site-wide theme.json settings or styles. After it succeeds, tell the user the theme update is staged in the editor and ready to review\/save, not live or published.":["\u7528\u9019\u500b\u4f86\u8a2d\u5b9a\u6574\u500b\u7db2\u7ad9\u7684 theme.json \u8a2d\u5b9a\u6216\u6a23\u5f0f\u3002\u6210\u529f\u5f8c\uff0c\u544a\u8a34\u4f7f\u7528\u8005\u4f48\u666f\u4e3b\u984c\u66f4\u65b0\u5df2\u5728\u7de8\u8f2f\u5668\u4e2d\u66ab\u5b58\uff0c\u4e26\u6e96\u5099\u597d\u6aa2\u8996\/\u5132\u5b58\uff0c\u9084\u6c92\u6709\u4e0a\u7dda\u6216\u5df2\u767c\u8868\u3002"],"Stages WordPress theme settings and styles using theme.json format.":["\u4f7f\u7528 theme.json \u683c\u5f0f\u8a2d\u7f6e\u548c\u6a23\u5f0f Stages WordPress \u4f48\u666f\u4e3b\u984c\u3002"],"Update theme":["\u66f4\u65b0\u4f48\u666f\u4e3b\u984c"],"The editor is still loading. Try the theme update again once the page is editable.":["\u7de8\u8f2f\u5668\u4ecd\u5728\u52a0\u8f09\u4e2d\u3002\u7b49\u9801\u9762\u53ef\u7de8\u8f2f\u5f8c\u518d\u8a66\u4e00\u6b21\u4f48\u666f\u4e3b\u984c\u66f4\u65b0\u3002"],"Displays a font, color, or pattern picker in the Easy Site Editor chat.":["\u5728\u7c21\u6613\u7db2\u7ad9\u7de8\u8f2f\u5668\u804a\u5929\u4e2d\u986f\u793a\u5b57\u578b\u3001\u984f\u8272\u6216\u7248\u9762\u914d\u7f6e\u9078\u64c7\u5668\u3002"],"Show picker":["\u986f\u793a\u9078\u64c7\u5668"],"The picker UI is still loading. Try the request again in a moment.":["\u9078\u64c7\u5668 UI \u9084\u5728\u52a0\u8f09\u4e2d\u3002\u7a0d\u5f8c\u518d\u8a66\u4e00\u6b21\u8acb\u6c42\u3002"],"Use this to show staged global font, color, or pattern choices. The user must select an option and save before changes are live.":["\u4f7f\u7528\u9019\u500b\u4f86\u986f\u793a\u5206\u968e\u6bb5\u7684\u5168\u7403\u5b57\u578b\u3001\u984f\u8272\u6216\u7248\u9762\u914d\u7f6e\u9078\u64c7\u3002\u4f7f\u7528\u8005\u5fc5\u9808\u9078\u53d6\u4e00\u500b\u9078\u9805\u4e26\u4fdd\u5b58\uff0c\u624d\u80fd\u8b93\u8b8a\u66f4\u751f\u6548\u3002"],"Use this when the user asks to navigate, go to, open, view, or switch to a site page. If you call this after creating a new page, page creation is already complete before this tool runs. If navigation is canceled because the current page has unsaved changes, do not continue or retry page creation; tell the user the page exists and they need to save or discard their current changes before opening it.":["\u7576\u4f7f\u7528\u8005\u8981\u6c42\u5c0e\u89bd\u3001\u524d\u5f80\u3001\u6253\u958b\u3001\u6aa2\u8996\u6216\u5207\u63db\u5230\u7db2\u7ad9\u9801\u9762\u6642\u4f7f\u7528\u9019\u500b\u3002\u5982\u679c\u5728\u5275\u5efa\u65b0\u9801\u9762\u5f8c\u547c\u53eb\u9019\u500b\u5de5\u5177\uff0c\u9801\u9762\u5275\u5efa\u5728\u9019\u500b\u5de5\u5177\u904b\u884c\u4e4b\u524d\u5df2\u7d93\u5b8c\u6210\u3002\u5982\u679c\u56e0\u70ba\u7576\u524d\u9801\u9762\u6709\u672a\u5132\u5b58\u7684\u8b8a\u66f4\u800c\u53d6\u6d88\u5c0e\u89bd\uff0c\u8acb\u4e0d\u8981\u7e7c\u7e8c\u6216\u91cd\u8a66\u9801\u9762\u5275\u5efa\uff1b\u544a\u8a34\u4f7f\u7528\u8005\u8a72\u9801\u9762\u5df2\u5b58\u5728\uff0c\u4ed6\u5011\u9700\u8981\u5728\u6253\u958b\u4e4b\u524d\u5132\u5b58\u6216\u653e\u68c4\u7576\u524d\u7684\u8b8a\u66f4\u3002"],"Navigates the Easy Site Editor preview to a specific site page or to the pages list.":["\u5c0e\u822a\u5230\u7c21\u6613\u7db2\u7ad9\u7de8\u8f2f\u5668\u9810\u89bd\u7684\u7279\u5b9a\u7db2\u7ad9\u9801\u9762\u6216\u9801\u9762\u5217\u8868\u3002"],"Navigate":["\u5c0e\u89bd"],"Editor navigation is still loading. Try navigating again in a moment.":["\u7de8\u8f2f\u5668\u5c0e\u89bd\u4ecd\u5728\u52a0\u8f09\u4e2d\u3002\u7a0d\u5f8c\u518d\u8a66\u8457\u5c0e\u89bd\u4e00\u6b21\u3002"],"Stages block updates, insertions, and deletions in the client-side editor for review before saving.":["\u5728\u5ba2\u6236\u7aef\u7de8\u8f2f\u5668\u4e2d\u66ab\u5b58\u5340\u584a\u7684\u66f4\u65b0\u3001\u63d2\u5165\u548c\u522a\u9664\uff0c\u4ee5\u4fbf\u5728\u5132\u5b58\u4e4b\u524d\u9032\u884c\u6aa2\u8996\u3002"],"Apply block edits":["\u61c9\u7528\u5340\u584a\u7de8\u8f2f"],"Abilities for staging edits in the Easy Site Editor.":["\u5728\u7c21\u6613\u7db2\u7ad9\u7de8\u8f2f\u5668\u4e2d\u9032\u884c\u9810\u5099\u7de8\u8f2f\u7684\u80fd\u529b\u3002"],"Easy Site Editor":["\u7c21\u6613\u7db2\u7ad9\u7de8\u8f2f\u5668"],"The editor is still loading. Try the block edit again once the page is editable.":["\u7de8\u8f2f\u5668\u4ecd\u5728\u52a0\u8f09\u4e2d\u3002\u7b49\u9801\u9762\u53ef\u7de8\u8f2f\u5f8c\u518d\u8a66\u4e00\u6b21\u5340\u584a\u7de8\u8f2f\u3002"],"Use this for current-page content and layout edits. After it succeeds, tell the user the edits are staged in the editor and ready to review\/save, not live or published.":["\u7528\u9019\u500b\u4f86\u7de8\u8f2f\u7576\u524d\u9801\u9762\u7684\u5167\u5bb9\u548c\u4f48\u5c40\u3002\u6210\u529f\u5f8c\uff0c\u544a\u8a34\u4f7f\u7528\u8005\u7de8\u8f2f\u5df2\u5728\u7de8\u8f2f\u5668\u4e2d\u66ab\u5b58\uff0c\u6e96\u5099\u597d\u6aa2\u8996\/\u5132\u5b58\uff0c\u4f46\u5c1a\u672a\u4e0a\u7dda\u6216\u5df2\u767c\u8868\u3002"]}}}