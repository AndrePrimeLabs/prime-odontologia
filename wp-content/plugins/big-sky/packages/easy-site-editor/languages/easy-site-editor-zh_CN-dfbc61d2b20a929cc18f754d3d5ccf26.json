0\u5df2\u5728\u7f16\u8f91\u5668\u4e2d\u51c6\u5907\u5c31\u7eea\u3002"],"Cannot stage a pattern layout without blocks.":["\u65e0\u6cd5\u5728\u6ca1\u6709\u533a\u5757\u7684\u60c5\u51b5\u4e0b\u5c55\u793a\u6837\u677f\u5e03\u5c40\u3002"],"Start a new conversation":["\u5f00\u59cb\u65b0\u5bf9\u8bdd"],"Publishing\u2026":["\u6b63\u5728\u53d1\u5e03\u2026"],"Saving\u2026":["\u6b63\u5728\u4fdd\u5b58\u2026"],"Save":["\u4fdd\u5b58"],"Save draft":["\u4fdd\u5b58\u8349\u7a3f"],"Keep editing":["\u7ee7\u7eed\u7f16\u8f91"],"Unsaved changes":["\u672a\u4fdd\u5b58\u7684\u66f4\u6539"],"Edit":["\u7f16\u8f91"],"Edit mode":["\u7f16\u8f91\u6a21\u5f0f"],"Preview":["\u9884\u89c8"],"Preview mode":["\u9884\u89c8\u6a21\u5f0f"],"Editor mode":["\u7f16\u8f91\u5668\u6a21\u5f0f"],"Use this for site-wide theme.json settings or styles. After it succeeds, tell the user the theme update is staged in the editor and ready to review\/save, not live or published.":["\u5c06\u6b64\u7528\u4e8e\u7ad9\u70b9\u8303\u56f4\u5185\u7684 theme.json \u8bbe\u7f6e\u6216\u6837\u5f0f\u3002\u6210\u529f\u540e\uff0c\u544a\u8bc9\u7528\u6237\u4e3b\u9898\u66f4\u65b0\u5df2\u5728\u7f16\u8f91\u5668\u4e2d\u51c6\u5907\u597d\u8fdb\u884c\u5ba1\u6838\/\u4fdd\u5b58\uff0c\u4f46\u5c1a\u672a\u4e0a\u7ebf\u6216\u53d1\u5e03\u3002"],"Stages WordPress theme settings and styles using theme.json format.":["\u4f7f\u7528 theme.json \u683c\u5f0f\u8bbe\u7f6e\u548c\u6837\u5f0f Stages WordPress \u4e3b\u9898\u3002"],"Update theme":["\u66f4\u65b0\u4e3b\u9898"],"The editor is still loading. Try the theme update again once the page is editable.":["\u7f16\u8f91\u5668\u4ecd\u5728\u52a0\u8f7d\u4e2d\u3002\u4e00\u65e6\u9875\u9762\u53ef\u7f16\u8f91\uff0c\u8bf7\u518d\u6b21\u5c1d\u8bd5\u66f4\u65b0\u4e3b\u9898\u3002"],"Displays a font, color, or pattern picker in the Easy Site Editor chat.":["\u5728\u7b80\u5355\u7ad9\u70b9\u7f16\u8f91\u5668\u804a\u5929\u4e2d\u663e\u793a\u5b57\u4f53\u3001\u989c\u8272\u6216\u6837\u677f\u9009\u62e9\u5668\u3002"],"Show picker":["\u663e\u793a\u9009\u62e9\u5668"],"The picker UI is still loading. Try the request again in a moment.":["\u9009\u62e9\u5668 UI \u4ecd\u5728\u52a0\u8f7d\u3002\u7a0d\u540e\u518d\u8bd5\u8bf7\u6c42\u3002"],"Use this to show staged global font, color, or pattern choices. The user must select an option and save before changes are live.":["\u4f7f\u7528\u6b64\u529f\u80fd\u663e\u793a\u5206\u9636\u6bb5\u7684\u5168\u7403\u5b57\u4f53\u3001\u989c\u8272\u6216\u6837\u677f\u9009\u62e9\u3002\u7528\u6237\u5fc5\u987b\u9009\u62e9\u4e00\u4e2a\u9009\u9879\u5e76\u4fdd\u5b58\uff0c\u624d\u80fd\u4f7f\u66f4\u6539\u751f\u6548\u3002"],"Use this when the user asks to navigate, go to, open, view, or switch to a site page. If you call this after creating a new page, page creation is already complete before this tool runs. If navigation is canceled because the current page has unsaved changes, do not continue or retry page creation; tell the user the page exists and they need to save or discard their current changes before opening it.":["\u5f53\u7528\u6237\u8bf7\u6c42\u5bfc\u822a\u3001\u524d\u5f80\u3001\u6253\u5f00\u3001\u67e5\u770b\u6216\u5207\u6362\u5230\u4e00\u4e2a\u7ad9\u70b9\u9875\u9762\u65f6\uff0c\u8bf7\u4f7f\u7528\u6b64\u5de5\u5177\u3002\u5982\u679c\u5728\u521b\u5efa\u65b0\u9875\u9762\u540e\u8c03\u7528\u6b64\u5de5\u5177\uff0c\u5219\u9875\u9762\u521b\u5efa\u5728\u6b64\u5de5\u5177\u8fd0\u884c\u4e4b\u524d\u5df2\u7ecf\u5b8c\u6210\u3002\u5982\u679c\u7531\u4e8e\u5f53\u524d\u9875\u9762\u6709\u672a\u4fdd\u5b58\u7684\u66f4\u6539\u800c\u53d6\u6d88\u5bfc\u822a\uff0c\u8bf7\u4e0d\u8981\u7ee7\u7eed\u6216\u91cd\u8bd5\u9875\u9762\u521b\u5efa\uff1b\u544a\u8bc9\u7528\u6237\u8be5\u9875\u9762\u5df2\u5b58\u5728\uff0c\u4ed6\u4eec\u9700\u8981\u5728\u6253\u5f00\u4e4b\u524d\u4fdd\u5b58\u6216\u653e\u5f03\u5f53\u524d\u66f4\u6539\u3002"],"Navigates the Easy Site Editor preview to a specific site page or to the pages list.":["\u5bfc\u822a\u5230\u7b80\u5355\u7ad9\u70b9\u7f16\u8f91\u5668\u9884\u89c8\u7684\u7279\u5b9a\u7ad9\u70b9\u9875\u9762\u6216\u9875\u9762\u5217\u8868\u3002"],"Navigate":["\u5bfc\u822a"],"Editor navigation is still loading. Try navigating again in a moment.":["\u7f16\u8f91\u5668\u5bfc\u822a\u4ecd\u5728\u52a0\u8f7d\u3002\u7a0d\u540e\u518d\u8bd5\u7740\u5bfc\u822a\u4e00\u4e0b\u3002"],"Stages block updates, insertions, and deletions in the client-side editor for review before saving.":["\u5728\u5ba2\u6237\u7aef\u7f16\u8f91\u5668\u4e2d\u5bf9\u533a\u5757\u7684\u66f4\u65b0\u3001\u63d2\u5165\u548c\u5220\u9664\u8fdb\u884c\u9636\u6bb5\u6027\u5904\u7406\uff0c\u4ee5\u4fbf\u5728\u4fdd\u5b58\u4e4b\u524d\u8fdb\u884c\u5ba1\u6838\u3002"],"Apply block edits":["\u5e94\u7528\u533a\u5757\u7f16\u8f91"],"Abilities for staging edits in the Easy Site Editor.":["\u5728\u7b80\u5355\u7ad9\u70b9\u7f16\u8f91\u5668\u4e2d\u8fdb\u884c\u7f16\u8f91\u7684\u80fd\u529b\u3002"],"Easy Site Editor":["\u7b80\u5355\u7ad9\u70b9\u7f16\u8f91\u5668"],"The editor is still loading. Try the block edit again once the page is editable.":["\u7f16\u8f91\u5668\u4ecd\u5728\u52a0\u8f7d\u3002\u9875\u9762\u53ef\u7f16\u8f91\u540e\u518d\u8bd5\u4e00\u6b21\u533a\u5757\u7f16\u8f91\u3002"],"Use this for current-page content and layout edits. After it succeeds, tell the user the edits are staged in the editor and ready to review\/save, not live or published.":["\u4f7f\u7528\u6b64\u529f\u80fd\u8fdb\u884c\u5f53\u524d\u9875\u9762\u5185\u5bb9\u548c\u5e03\u5c40\u7684\u7f16\u8f91\u3002\u6210\u529f\u540e\uff0c\u544a\u8bc9\u7528\u6237\u7f16\u8f91\u5df2\u5728\u7f16\u8f91\u5668\u4e2d\u6682\u5b58\uff0c\u51c6\u5907\u597d\u8fdb\u884c\u5ba1\u6838\/\u4fdd\u5b58\uff0c\u4f46\u5c1a\u672a\u4e0a\u7ebf\u6216\u53d1\u5e03\u3002"]}}}