{"locale_data":{"messages":{"":{"plural_forms":"nplurals=2; plural=(n > 1);","language":"pt_BR","project_id_version":"MailPoet - MailPoet"},"Save your changes.":["Salve suas altera\u00e7\u00f5es."],"Automation settings":["Configura\u00e7\u00f5es de automa\u00e7\u00e3o"],"There are unsaved changes that will be lost. Do you want to continue?":["Existem altera\u00e7\u00f5es n\u00e3o salvas que ser\u00e3o perdidas. Voc\u00ea quer continuar?"],"Automation":["Automa\u00e7\u00e3o"],"View all your automations to track statistics and create new ones.":["Visualize todas as suas automa\u00e7\u00f5es para rastrear estat\u00edsticas e criar novas."],"What\u2019s next?":["O que vem a seguir?"],"\"%s\" is now live.":["\"%s\" agora est\u00e1 ativo."],"Double-check your settings before activating.":["Verifique suas configura\u00e7\u00f5es antes de ativar."],"Are you ready to activate?":["Voc\u00ea est\u00e1 pronto para ativar?"],"Activating\u2026":["Ativando\u2026"],"Close settings":["Fechar configura\u00e7\u00f5es"],"Automation details":["Detalhes de automa\u00e7\u00e3o"],"Step":["Etapa"],"Show or hide the settings sidebar.":["Mostre ou oculte a barra lateral de configura\u00e7\u00f5es."],"Toggle fullscreen mode.":["Alternar o modo de tela cheia."],"View all automations":["Ver todas as automa\u00e7\u00f5es"],"Cancel":["Cancelar"],"Activate":["Ativar"],"Close":["Fechar"],"Settings":["Configura\u00e7\u00f5es"],"An unknown error occurred.":["Ocorreu um erro desconhecido."]}}}