/* WordPress inserts margin-block-start: var(--wp--style--block-gap) between the
   template's top-level sections (header part, main, footer part) — a gap that
   exists even when no markup asks for it. Zero it so sections butt edge-to-edge
   and own their vertical rhythm via padding; this does not affect block gaps
   inside nested layouts. */
.wp-site-blocks > * + * {
	margin-block-start: 0;
}

/* With that gap gone, main carries its own vertical padding so templates this
   theme does not author (WooCommerce shop, product, cart…) still clear the
   header and footer. A descendant selector, not a child one: WooCommerce wraps
   the single-product main in an extra group. Templates built from full-bleed
   sections opt out with is-flush and let the sections own the rhythm. */
.wp-site-blocks main {
	padding-block: var(--wp--preset--spacing--60) var(--wp--preset--spacing--70);
}
.wp-site-blocks main.is-flush {
	padding-block: 0;
}

/* === typography === */
.hero-eyebrow,
.section-note,
.stat-label {
	text-transform: uppercase;
	font-size: 0.78rem;
	font-weight: 600;
	letter-spacing: 0.08em;
}

/* === header === */
.site-header {
	background: var(--wp--preset--color--background);
	border-bottom: 1px solid var(--wp--preset--color--line);
}
.site-brand {
	font-weight: 700;
	color: var(--wp--preset--color--primary);
	letter-spacing: -0.01em;
}
.site-header .wp-block-navigation a {
	font-weight: 600;
	color: var(--wp--preset--color--text);
}

/* === hero === */
.home-hero {
	min-height: 84vh;
	color: var(--wp--preset--color--background);
}
.hero-stack {
	max-width: 640px;
}
.hero-title {
	font-size: clamp(2.4rem, 5vw, 4rem);
	letter-spacing: -0.01em;
	margin-block: 0.75rem 1.25rem;
}
.hero-eyebrow {
	color: var(--wp--preset--color--accent);
	margin: 0;
}
.hero-title {
	color: var(--wp--preset--color--background);
	margin-block: 0 0;
}
.hero-lead {
	max-width: 46ch;
	font-size: 1.15rem;
	color: var(--wp--preset--color--background);
	opacity: 0.92;
	margin-block-end: 0.5rem;
}
.home-hero .is-style-fill .wp-element-button {
	background: var(--wp--preset--color--accent);
}
.home-hero .is-style-outline .wp-element-button {
	background: transparent;
	color: var(--wp--preset--color--background);
	border: 1px solid rgba(255, 255, 255, 0.55);
}

/* === reel === */
.reel-section {
	overflow: hidden;
	padding-block: var(--wp--preset--spacing--70);
}
.reel {
	width: 120vw;
	margin-inline-start: -10vw;
	display: flex;
	gap: 1.5rem;
	height: 280px;
}
.reel-a {
	transform: rotate(-4deg);
}
.reel-b {
	transform: rotate(4deg);
}
.reel .wp-block-image {
	flex: 0 0 400px;
	margin: 0;
}
.reel .wp-block-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	border-radius: var(--wp--custom--rounded--sm, 6px);
}

/* === sections === */
.section {
	padding-block: var(--wp--preset--spacing--section);
}
.section-gray {
	background: var(--wp--preset--color--surface);
}
.section-white {
	background: var(--wp--preset--color--background);
}
.section-head {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 2rem;
	margin-block-end: 2.5rem;
}
.section-head h2 {
	color: var(--wp--preset--color--primary);
	font-size: clamp(1.9rem, 3.5vw, 2.6rem);
}
.section-note {
	color: var(--wp--preset--color--secondary);
	max-width: 34ch;
	margin: 0;
	text-align: right;
}
.story-img img {
	width: 100%;
	height: 360px;
	object-fit: cover;
	border-radius: var(--wp--custom--rounded--sm, 6px);
}
.story-text {
	color: var(--wp--preset--color--secondary);
	font-size: 1.1rem;
}
.story-text p:first-child {
	margin-block-start: 0;
}

/* === service cards === */
.service-card {
	background: var(--wp--preset--color--surface);
	border: 1px solid var(--wp--preset--color--line);
	border-radius: var(--wp--custom--rounded--sm, 6px);
	box-shadow: 0 1px 3px rgb(16 24 40 / 0.06);
	padding: 1.75rem;
}
.service-card h3 {
	color: var(--wp--preset--color--primary);
	font-size: 1.2rem;
}
.service-card p {
	color: var(--wp--preset--color--secondary);
}

/* === stats === */
.stats .wp-block-column {
	padding: 1rem 1rem 1rem 0;
}
.stat-number {
	color: var(--wp--preset--color--primary);
	font-size: clamp(2.2rem, 4vw, 3rem);
	font-weight: 700;
	font-variant-numeric: tabular-nums;
	margin-block-end: 0.35rem;
}
.stat-label {
	color: var(--wp--preset--color--secondary);
	margin: 0;
}

/* === blog cards === */
.post-card {
	border: 1px solid var(--wp--preset--color--line);
	border-radius: var(--wp--custom--rounded--sm, 6px);
	box-shadow: 0 1px 3px rgb(16 24 40 / 0.06);
	overflow: hidden;
}
.post-card .wp-block-post-featured-image {
	margin: 0;
}
.post-card .wp-block-post-featured-image img {
	width: 100%;
	height: 210px;
	object-fit: cover;
	border-radius: 0;
}
.post-card .wp-block-post-title {
	color: var(--wp--preset--color--primary);
	padding: 1.25rem 1.25rem 0;
	font-size: 1.15rem;
}
.post-card .wp-block-post-excerpt {
	padding: 0.6rem 1.25rem 1.25rem;
	color: var(--wp--preset--color--secondary);
}

/* === cta + footer === */
.home-cta {
	background: var(--wp--preset--color--primary);
	color: var(--wp--preset--color--background);
	padding-block: var(--wp--preset--spacing--section);
}
.cta-stack {
	text-align: center;
}
.cta-stack h2 {
	font-size: clamp(1.9rem, 3.5vw, 2.6rem);
}
.cta-stack p {
	max-width: 52ch;
	margin-inline: auto;
	opacity: 0.9;
}
.cta-stack .wp-block-buttons {
	justify-content: center;
}
.home-cta .is-style-fill .wp-element-button {
	background: var(--wp--preset--color--background);
	color: var(--wp--preset--color--primary);
}
.site-footer {
	background: var(--wp--preset--color--primary);
	color: var(--wp--preset--color--background);
	padding-block: var(--wp--preset--spacing--70);
}
.site-footer .footer-brand .site-brand {
	color: var(--wp--preset--color--background);
}
.site-footer h3 {
	color: var(--wp--preset--color--background);
	font-size: 0.95rem;
	letter-spacing: 0.06em;
	text-transform: uppercase;
}
.site-footer p {
	color: rgba(255, 255, 255, 0.82);
}
.site-footer a {
	color: rgba(255, 255, 255, 0.9);
}
.footer-rule {
	border-color: rgba(255, 255, 255, 0.2);
	margin-block: 2rem;
}
.footer-copy {
	font-size: 0.9rem;
}

/* === responsive === */
@media (max-width: 900px) {
	.reel {
		width: 100vw;
		margin-inline-start: 0;
		height: 150px;
		transform: none;
		overflow-x: auto;
	}
	.reel .wp-block-image {
		flex: 0 0 220px;
	}
	.section {
		padding-block: var(--wp--preset--spacing--60);
	}
	.section-head {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}
	.section-note {
		text-align: left;
	}
	.home-hero {
		min-height: 70vh;
	}
}
