                if (project.hasClass('opening')) {
                    return false;
                }

                project.addClass('opening');

                var numcol = Math.round(wrapperWidth / project.width());
                var insertAfterIndex;
                if (numcol > l) {
                    insertAfterIndex = l - 1;
                } else {
                    insertAfterIndex = calcItemIndex(numcol, projectIndex);
