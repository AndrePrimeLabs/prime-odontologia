.sbi-source-redirect-ld {
    text-align: center;
}

.sbi-source-redirect-ld div {
    display: inline-block;
    width: 32px;
    height: 32px;
    border-radius: 50px;
    margin: 0 10px;
    position: relative;
    background-color: #0096CC;
    color: #0096CC;
    -webkit-animation: sb-source-redirect var(--sb-duration-1000) infinite linear alternate;
    animation: sb-source-redirect var(--sb-duration-1000) infinite linear alternate;
    -webkit-animation-delay: var(--sb-duration-500);
    animation-delay: var(--sb-duration-500);
}

.sbi-source-redirect-ld div:before,
.sbi-source-redirect-ld div:after {
    content: '';
    display: inline-block;
    position: absolute;
    top: 0;
}

.sbi-source-redirect-ld div:before {
    left: -45px;
    width: 32px;
    height: 32px;
    border-radius: 50px;
    background-color: #0096CC;
    color: #0096CC;
    -webkit-animation: sb-source-redirect var(--sb-duration-1000) infinite alternate;
    animation: sb-source-redirect var(--sb-duration-1000) infinite alternate;
    -webkit-animation-delay: 0s;
    animation-delay: 0s;
}

.sbi-source-redirect-ld div:after {
    left: 45px;
    width: 32px;
    height: 32px;
    border-radius: 50px;
    background-color: #0096CC;
    color: #0096CC;
    -webkit-animation: sb-source-redirect var(--sb-duration-1000) infinite alternate;
    animation: sb-source-redirect var(--sb-duration-1000) infinite alternate;
    -webkit-animation-delay: var(--sb-duration-1000);
    animation-delay: var(--sb-duration-1000);
}


@-webkit-keyframes sb-source-redirect {
    0% {
        background-color: #0096CC;
    }
    50%, 100% {
        background-color: #B5E5FF;
    }
}

@keyframes sb-source-redirect {
    0% {
        background-color: #0096CC;
    }
    50%, 100% {
        background-color: #B5E5FF;
    }
}


