.health-check-accordion-trigger:focus {
	color: #1d2327;
	border: none;
	box-shadow: none;
	outline-offset: -1px;
	outline: 2px solid var(--wp-admin-theme-color);
	background-color: #f6f7f7;
}

.privacy-settings-accordion-trigger .title,
.health-check-accordion-trigger .title {
	pointer-events: none;
	font-weight: 600;
	flex-grow: 1;
