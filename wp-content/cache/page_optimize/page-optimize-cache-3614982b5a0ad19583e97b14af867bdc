.wp-core-ui .wp-full-overlay .collapse-sidebar {
	position: fixed;
	bottom: 0;
	left: 0;
	padding: 9px 0 9px 10px;
	height: 45px;
	color: #646970;
	outline: 0;
	line-height: 1;
